<Page x:Class="UnoPlatform.AdSense.Sample.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UnoPlatform.AdSense.Sample"
      xmlns:adsense="using:UnoPlatform.AdSense"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <ScrollViewer IsTabStop="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0"
                  Margin="20"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <TextBlock AutomationProperties.AutomationId="HelloTextBlock"
                   Text="AdSense Control Demo"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,10" />
        <TextBlock Text="This sample demonstrates the AdSense control for Uno Platform"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10" />
        <TextBlock Text="Replace the ClientId and SlotId with your own AdSense credentials"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   FontStyle="Italic"
                   Foreground="Gray" />
      </StackPanel>

      <Border Grid.Row="1"
              Height="250"
              Margin="20"
              BorderBrush="Gray"
              BorderThickness="1"
              Background="White">
        <adsense:AdSenseControl ClientId="ca-pub-0000000000000000"
                                SlotId="0000000000"
                                AdFormat="auto"
                                IsResponsive="True" />
      </Border>

      <StackPanel Grid.Row="2"
                  Margin="20"
                  HorizontalAlignment="Center">
        <TextBlock Text="Configuration:"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />
        <TextBlock TextWrapping="Wrap">
          <Run Text="• ClientId: Your AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX)" />
          <LineBreak />
          <Run Text="• SlotId: Your ad unit ID" />
          <LineBreak />
          <Run Text="• AdFormat: auto, rectangle, vertical, or horizontal" />
          <LineBreak />
          <Run Text="• IsResponsive: Enable responsive ads" />
        </TextBlock>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
